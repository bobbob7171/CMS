{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Iinclude",
                "${workspaceFolder}\\src\\main.c",
                "${workspaceFolder}\\src\\fileio.c",
                "${workspaceFolder}\\src\\operations.c",
                "${workspaceFolder}\\src\\enhance.c",
                "${workspaceFolder}\\src\\unique.c",
                "${workspaceFolder}\\src\\utils.c",
                "-o",
                "${workspaceFolder}\\CMS.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all source files with include directory"
        }
    ],
    "version": "2.0.0"
}